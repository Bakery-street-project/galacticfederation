{
  "name": "repotruth",
  "version": "0.1.0",
  "description": "Deterministic honesty and hygiene auditor for (AI-generated) repositories.",
  "private": true,
  "type": "module",
  "bin": {
    "repotruth": "dist/src/bin.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\"",
    "audit:self": "node dist/src/bin.js audit .."
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/node": "22.20.4",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "yaml": "2.9.1"
  }
}
